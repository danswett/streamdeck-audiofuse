{
	"name": "streamdeck-audiofuse",
	"version": "1.0.0",
	"private": true,
	"description": "Stream Deck plugin that controls an Arturia AudioFuse 16Rig or Studio through the AudioFuse Control Center HTTP API.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "npm run build:icons && rollup -c",
		"build:icons": "node tools/build-icons.mjs",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.bad-duck.audiofuse\"",
		"validate": "streamdeck validate com.bad-duck.audiofuse.sdPlugin",
		"test": "vitest run",
		"pack": "npm run build && streamdeck pack com.bad-duck.audiofuse.sdPlugin --output dist --force --no-update-check"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.2",
		"@elgato/utils": "^0.6.0"
	}
}
